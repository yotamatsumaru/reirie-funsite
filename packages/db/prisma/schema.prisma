// =====================================================================
// アイドルファンサイト データベーススキーマ
// PostgreSQL 15.x / Prisma 5.x
// =====================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Enums
// =====================================================================

enum PlanType {
  FREE
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum AccessLevel {
  PUBLIC
  MEMBERS
  PREMIUM
}

/// お問い合わせの対応状況
enum ContactStatus {
  NEW // 新規 (未対応)
  IN_PROGRESS // 対応中
  RESOLVED // 対応済み
  CLOSED // クローズ (対応不要 / スパム等)
}

/// お問い合わせの種別
enum ContactCategory {
  GENERAL // 一般
  ACCOUNT // アカウント / ログイン
  BILLING // 支払い / 会員プラン
  SHIPPING // 配送 / グッズ
  BUG // 不具合報告
  OTHER // その他
}

enum ContentType {
  BLOG
  GALLERY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentKind {
  SUBSCRIPTION
  ONE_TIME_ORDER
  TICKET_FEE
}

enum TicketLinkStatus {
  PENDING
  LINKED
  REVOKED
}

enum UserRole {
  USER
  ADMIN
  // STAFF: スタッフ管理者。SUPER_ADMIN と同じ画面を「閲覧」できるが、
  // 返金 / BAN / ロール変更などの書き込み操作はできない (read-only 運営)。
  STAFF
  SUPER_ADMIN
}

enum AdminInvitationStatus {
  PENDING // 招待送信済み・未受諾
  ACCEPTED // 受諾され管理者になった
  REVOKED // スーパー管理者が取消
  EXPIRED // 有効期限切れ
}

// Pui 取引の理由。
// 【2026-07 統合】以前は「Fan ポイント (無料)」と「特典ポイント (課金/会員特典)」の
// 2 種類の通貨があったが、Pui 1 種類に統合した。旧 RewardPointReason の
// 理由もすべてこの enum に統合し、Stripe 購入・サブスク月次特典・景品交換もすべて
// Pui (User.pui / PuiTransaction) で扱う。
// 【2026-07 通貨名変更】さらに通貨名を「Fan ポイント」から「Pui」へ変更した。
enum PuiReason {
  LOGIN_BONUS // 毎日のログインボーナス
  LOGIN_STREAK // 連続ログインボーナス
  SOCIAL_SHARE // SNS シェア (X / Instagram)
  ADMIN_ADJUST // 管理者による手動調整
  SIGNUP_BONUS // 新規登録ボーナス
  GAME_REWARD // ミニゲーム勝利報酬
  ITEM_PURCHASE // 恋愛ADVの章/アイテムを Pui で購入 (消費)
  EXTRA_PLAY_PURCHASE // ミニゲームの追加プレイ回数を Pui で購入 (消費)
  STRIPE_PURCHASE // Stripe でポイントパックを購入 (旧 RewardPointReason)
  SUBSCRIPTION_BONUS // サブスクプランの月次自動付与 (旧 RewardPointReason)
  REDEMPTION // 景品交換 (消費) (旧 RewardPointReason)
  REFUND // 交換キャンセル等による返還 (旧 RewardPointReason)
  MERGE_ADJUST // 特典ポイント統合時の残高付け替え (移行用)
  OTHER
}

// 特典ポイント購入 (Stripe) の状態
enum RewardPointPurchaseStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// 景品カタログの状態
enum RewardCatalogItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// 景品カタログの種別
enum RewardCatalogItemKind {
  GOODS // 実物グッズ (発送が必要)
  CALL_PRIORITY // 特典会優先枠
  DIGITAL // デジタル特典 (発送不要)
}

// 景品交換 (発送管理) の状態
enum RewardRedemptionStatus {
  PENDING // 交換申請受付・処理待ち
  PROCESSING // 運営が発送準備中
  SHIPPED // 発送済み
  COMPLETED // 到着確認 / デジタル特典付与完了
  CANCELED // キャンセル (ポイント返還)
}

// ミニゲームの種類
enum MiniGameType {
  ACCHI_MUITE_HOI // あっち向いてホイ
}

// ミニゲームの1プレイ結果
enum MiniGameResult {
  WIN // プレイヤー勝利
  LOSE // プレイヤー敗北
  DRAW // あいこ
}

// SNS シェア対象プラットフォーム
enum SocialPlatform {
  X // X (旧 Twitter)
  INSTAGRAM
}

// REIRIE への DM の状態
enum DirectMessageStatus {
  SENT // 送信済み (運営未読)
  READ // 運営が既読
  REPLIED // 運営が返信済み (将来用)
}

// =====================================================================
// Call Event Enums (特典会 1on1)
// =====================================================================

enum CallEventStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum CallTicketStatus {
  WAITING // チケット引換済み・まだイベント開始前 or 待機室未入室
  IN_WAITING_ROOM // 待機室入室済み・順番待ち
  IN_MAIN_ROOM // 本ルームでアイドルと通話中
  DONE // 通話終了
  NO_SHOW // 呼ばれたが応答無し・運営判断でスキップ
}

// =====================================================================
// Game Enums (恋愛 ADV)
// =====================================================================

enum GameCharacterStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GameScenarioStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GameAssetKind {
  SPRITE // 立ち絵
  EXPRESSION // 表情差分
  CG // イベントCG
  BACKGROUND // 背景
  BGM // BGM
  SE // 効果音
  VOICE // ボイス
}

enum GameItemKind {
  GIFT // プレゼント (親密度ブースト)
  COSMETIC // 衣装・装飾
  CG_PACK // CG セット
  VOICE_PACK // ボイス集
}

enum GameRouteResult {
  IN_PROGRESS // 進行中
  FRIEND_END // 友情エンド
  LOVE_END // 恋愛エンド
  SPECIAL_END // 特別エンド
  BAD_END // バッドエンド
}

enum GamePurchaseKind {
  SCENARIO // 章購入
  ITEM // アイテム購入
  PACK // セット購入
}

// ゲーム内購入 (PlayerPurchase) の決済手段
enum GamePurchasePayMethod {
  STRIPE // クレジットカード決済 (JPY)
  PUI // Pui 消費 (即時確定)
}

// =====================================================================
// Users / Auth (Auth.js v5)
// =====================================================================

model User {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique @db.Citext
  emailVerified           DateTime? @map("email_verified")
  passwordHash            String?   @map("password_hash") // Credentials Provider 用
  displayName             String?   @map("display_name")
  fullName                String?   @map("full_name")
  furigana                String?
  phone                   String?
  birthDate               DateTime? @map("birth_date") @db.Date
  postalCode              String?   @map("postal_code")
  prefecture              String?
  addressLine1            String?   @map("address_line_1")
  addressLine2            String?   @map("address_line_2")
  avatarUrl               String?   @map("avatar_url")
  // ファンが REIRIE に呼んでほしい名前 (DM の @ メンションで使用)。
  // 未設定なら displayName / "あなた" にフォールバックする。
  preferredName           String?   @map("preferred_name")
  role                    UserRole  @default(USER)
  // ADMIN に付与する領域別の管理権限 (CONTENT / MERCH / GAME / CALL)。
  // SUPER_ADMIN は常に全権限を持つため参照しない。
  adminCapabilities       String[]  @default([]) @map("admin_capabilities")
  // プロモーション / デモ配信用アカウントの有効期限 (DB カラム: promo_until)。
  //  - null            … 通常アカウント (プロモ特典なし)
  //  - 未来の日時       … プロモ有効中。ミニゲームの回数制限を撤廃し、勝率を
  //                       PREMIUM 相当に固定する (リリースイベントの配信などで
  //                       「何度でも勝ってみせる」デモができる)。
  //  - 過去の日時       … プロモ期限切れ (通常アカウントに戻る)。
  // 「無期限」にしたい場合は十分先の日時 (例: 2099-12-31) を入れる。
  //
  // 【重要】このカラムは「後付けマイグレーション」であり、本番 DB では未適用の
  // 期間が長く存在し得る。Prisma のモデルフィールドにすると、生成された Client が
  // User の全 SELECT / RETURNING に promo_until を含めてしまい、カラム未適用の DB では
  // select を明示しない全ての user.findUnique/update/create が
  // 「column promo_until does not exist」で 500 になる (= あっちむいてPUI のサーバーエラー)。
  // → 事故を根絶するため、あえて Prisma モデルには載せず、読み書きは生 SQL
  //   (safeGetPromoUntil / safeSetPromoUntil) 経由に限定する。カラム未適用でも安全。
  //   マイグレーション 20260713000000_add_user_promo_until 適用後に自動で機能する。
  marketingOptIn          Boolean   @default(false) @map("marketing_opt_in")
  // 会員番号 (RR-000123 形式)。登録順の連番を MemberCounter で採番する。
  // 既存ユーザーへは backfill スクリプトで付与するため nullable。
  memberNumber            String?   @unique @map("member_number")
  // 保有 Pui 残高。PuiTransaction の合計と一致させる。
  // 【2026-07 統合】以前は Fan ポイントと特典ポイント (課金/会員特典で貯まり、
  // 景品交換に使う別枠のポイント。旧 User.rewardPoints / RewardPointTransaction) の
  // 2 種類があったが、Pui 1 種類に統合した。ログイン・SNSシェア・ミニゲーム
  // 勝利に加え、Stripe 購入・サブスク月次特典もすべてこの残高に加算され、
  // 恋愛ADV購入・ミニゲーム追加プレイ・景品交換のいずれにも使える。
  // 【2026-07 通貨名変更】以前は「points」(Fan ポイント) という名称だったが、
  // 通貨名を「Pui」に変更したのに合わせてフィールド名も pui に変更した。
  pui                     Int       @default(0)
  // Stripe 関連を user に持たせる(1ユーザー1顧客)
  stripeCustomerId        String?   @unique @map("stripe_customer_id")
  // メール確認用トークン (旧: リンク方式。後方互換のため残置、新規登録では使用しない)
  verificationToken       String?   @unique @map("verification_token")
  // メール確認用の6桁コード (新規登録時にメール送信し、入力してもらう方式)
  verificationCode        String?   @map("verification_code")
  verificationCodeExpires DateTime? @map("verification_code_expires")
  // コード入力の失敗回数 (一定回数を超えたら再送を要求する)
  verificationAttempts    Int       @default(0) @map("verification_attempts")
  passwordResetToken      String?   @unique @map("password_reset_token")
  passwordResetExpires    DateTime? @map("password_reset_expires")
  // ログイン試行のブルートフォース対策 (アカウントロック方式)。
  // 連続失敗回数が MAX_FAILED_LOGIN_ATTEMPTS に達すると lockedUntil を設定しログインを一時ブロックする。
  failedLoginAttempts     Int       @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime? @map("locked_until")
  // TOTP (Google Authenticator 等) による2段階認証。SUPER_ADMIN 限定機能。
  //  - totpSecret は AES-256-GCM で暗号化して保存 (平文Base32を直接保存しない)
  //  - totpEnabled が true になるまでは未確定 (セットアップ中の仮登録状態)
  //  - totpBackupCodes はワンタイムのリカバリコード (scrypt ハッシュ済み) の配列。1つ使うたびに配列から取り除く
  totpSecret              String?   @map("totp_secret")
  totpEnabled             Boolean   @default(false) @map("totp_enabled")
  totpVerifiedAt          DateTime? @map("totp_verified_at")
  totpBackupCodes         String[]  @default([]) @map("totp_backup_codes")
  // 直近ログイン成功時刻。ログイン成功のたびに更新する (authenticateCredentials 内)。
  // Auth.js は session strategy=jwt のためログイン時にDB書き込みが発生せず、
  // この列がなければ「最終ログイン」を判定する手段がないため追加。
  lastLoginAt             DateTime? @map("last_login_at")
  // BAN (運営による強制退会) された場合の日時 / 理由。
  // deletedAt はユーザー自己都合の退会でも使われる共通フィールドのため、
  // 「運営が BAN した」ことを区別して記録するためにこの2列を追加する。
  // 復元 (BAN解除) 時には bannedAt/banReason は null に戻さずそのまま履歴として残す
  // (直近の BAN 理由をゴミ箱 UI で確認できるようにするため)。
  bannedAt                DateTime? @map("banned_at")
  banReason               String?   @map("ban_reason")
  deletedAt               DateTime? @map("deleted_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  accounts        Account[]
  sessions        Session[]
  subscriptions   Subscription[]
  orders          Order[]
  payments        Payment[]
  ticketLinks     TicketLink[]
  videoViewLogs   VideoViewLog[]
  contentComments ContentComment[]
  auditLogs       AuditLog[]
  announcements   Announcement[]

  // Admin Invitation (管理者メール招待)
  adminInvitationsSent     AdminInvitation[] @relation("AdminInvitationInvitedBy")
  adminInvitationsAccepted AdminInvitation[] @relation("AdminInvitationAcceptedBy")

  // Game (恋愛 ADV)
  playerProgresses  PlayerProgress[]
  playerInventories PlayerInventory[]
  playerPurchases   PlayerPurchase[]
  playerSaveSlots   PlayerSaveSlot[]
  bonusGiftGrants   BonusGiftGrant[]

  // Call (特典会 1on1)
  callEventsAsPerformer CallEvent[]  @relation("CallEventPerformer")
  callTickets           CallTicket[]
  callSerialsUsed       CallSerial[] @relation("CallSerialUsedBy")

  // Membership / Pui (会員カード & Pui)
  puiTransactions    PuiTransaction[]
  loginBonusGrants   LoginBonusGrant[]
  socialShareGrants  SocialShareGrant[]
  socialShareIntents SocialShareIntent[]

  // Mini Game (あっち向いてホイ等)
  miniGamePlays      MiniGamePlay[]
  extraPlayPurchases MiniGameExtraPlayPurchase[]

  // 景品カタログ関連 (交換は Pui を消費する。旧特典ポイント関連の名残の型/テーブル名は維持)
  rewardPointPurchases     RewardPointPurchase[]
  rewardRedemptions        RewardRedemption[]
  monthlyRewardPointGrants MonthlyRewardPointGrant[]
  rewardDownloadLogs       RewardDownloadLog[]

  // Direct Message (REIRIE への DM)
  directMessages DirectMessage[]

  // お問い合わせ (ログイン中に送信した場合に紐づく。ゲスト送信は null)
  contactMessages ContactMessage[]

  // 運営からの警告通知 (このユーザーが受け取った警告)
  warningsReceived UserWarning[] @relation("UserWarningTarget")
  // 運営側で警告を発行した SUPER_ADMIN (発行者としての履歴)
  warningsIssued   UserWarning[] @relation("UserWarningIssuedBy")

  // 誕生日メールの配信記録 (年ごと。マイページで閲覧可能)
  birthdayMailDeliveries BirthdayMailDelivery[]

  @@index([email])
  @@map("users")
}

// Auth.js (NextAuth) 標準テーブル
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================================================================
// Subscriptions (Stripe)
// =====================================================================

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  planType             PlanType           @map("plan_type")
  billingInterval      BillingInterval    @map("billing_interval")
  status               SubscriptionStatus
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  stripePriceId        String             @map("stripe_price_id")
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  // 期間満了時に切り替わる予約プラン (null = 予約なし)。
  // Stripe Subscription Schedule による将来フェーズと連動する。
  scheduledPlanType    PlanType?          @map("scheduled_plan_type")
  // 予約に使用している Stripe Subscription Schedule の ID (null = スケジュール未使用)。
  stripeScheduleId     String?            @map("stripe_schedule_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// =====================================================================
// Contents (Blog / Gallery)
// =====================================================================

model Content {
  id            String        @id @default(uuid()) @db.Uuid
  type          ContentType
  slug          String        @unique
  title         String
  excerpt       String?
  body          String        @db.Text
  coverImageUrl String?       @map("cover_image_url")
  accessLevel   AccessLevel   @default(PUBLIC) @map("access_level")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  authorName    String?       @map("author_name")
  tags          String[]      @default([])
  viewCount     Int           @default(0) @map("view_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  images   ContentImage[]
  comments ContentComment[]

  @@index([type, status, publishedAt])
  @@index([accessLevel])
  @@map("contents")
}

model ContentImage {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  url       String
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, sortOrder])
  @@map("content_images")
}

model ContentComment {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@map("content_comments")
}

// =====================================================================
// VOD Videos
// =====================================================================

model Video {
  id              String      @id @default(uuid()) @db.Uuid
  title           String
  description     String?     @db.Text
  thumbnailUrl    String?     @map("thumbnail_url")
  s3SourceKey     String      @map("s3_source_key")
  s3HlsKey        String?     @map("s3_hls_key")
  durationSeconds Int?        @map("duration_seconds")
  accessLevel     AccessLevel @default(MEMBERS) @map("access_level")
  status          VideoStatus @default(UPLOADING)
  publishedAt     DateTime?   @map("published_at")
  expiresAt       DateTime?   @map("expires_at")
  mediaConvertJob String?     @map("media_convert_job_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  viewLogs VideoViewLog[]

  @@index([status, publishedAt])
  @@index([accessLevel])
  @@map("videos")
}

model VideoViewLog {
  id        String   @id @default(uuid()) @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  watchedMs Int      @default(0) @map("watched_ms")
  ipHash    String?  @map("ip_hash")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([userId, createdAt])
  @@map("video_view_logs")
}

// =====================================================================
// Live Streams (AWS IVS)
// =====================================================================

model LiveStream {
  id               String      @id @default(uuid()) @db.Uuid
  title            String
  description      String?     @db.Text
  thumbnailUrl     String?     @map("thumbnail_url")
  ivsChannelArn    String      @map("ivs_channel_arn")
  ivsPlaybackUrl   String      @map("ivs_playback_url")
  isPrivate        Boolean     @default(true) @map("is_private")
  accessLevel      AccessLevel @default(MEMBERS) @map("access_level")
  status           LiveStatus  @default(SCHEDULED)
  scheduledStartAt DateTime?   @map("scheduled_start_at")
  startedAt        DateTime?   @map("started_at")
  endedAt          DateTime?   @map("ended_at")
  recordingS3Key   String?     @map("recording_s3_key")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([status, scheduledStartAt])
  @@index([accessLevel])
  @@map("live_streams")
}

// =====================================================================
// EC: Products / Variants / Inventory
// =====================================================================

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@map("product_categories")
}

model Product {
  id                 String   @id @default(uuid()) @db.Uuid
  categoryId         String?  @map("category_id") @db.Uuid
  slug               String   @unique
  name               String
  description        String?  @db.Text
  basePrice          Int      @map("base_price")
  memberPrice        Int?     @map("member_price")
  premiumPrice       Int?     @map("premium_price")
  taxRate            Int      @default(10) @map("tax_rate")
  isActive           Boolean  @default(true) @map("is_active")
  isMembersOnly      Boolean  @default(false) @map("is_members_only")
  isPremiumExclusive Boolean  @default(false) @map("is_premium_exclusive")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId, isActive])
  @@index([slug])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // 画像バイト列の DB 保存 (S3 未設定時のフォールバック).
  // EC2 standalone + PM2 cluster ではローカルディスク保存が配信先とズレ、
  // 再ビルドで消えるため、DB を単一の真実として保持し /api/media 経由で配信する。
  // S3 が設定済みの場合はここは null のまま (url が外部CDN/S3を指す)。
  data        Bytes?  @map("data")
  contentType String? @map("content_type")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  sku         String   @unique
  name        String
  optionColor String?  @map("option_color")
  optionSize  String?  @map("option_size")
  priceDelta  Int      @default(0) @map("price_delta")
  weightGrams Int?     @map("weight_grams")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id          String   @id @default(uuid()) @db.Uuid
  variantId   String   @unique @map("variant_id") @db.Uuid
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  safetyStock Int      @default(0) @map("safety_stock")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

// =====================================================================
// EC: Cart / Orders
// =====================================================================

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  sessionId String?    @map("session_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  orderNumber        String      @unique @map("order_number")
  userId             String      @map("user_id") @db.Uuid
  status             OrderStatus @default(PENDING)
  subtotal           Int
  taxAmount          Int         @map("tax_amount")
  shippingFee        Int         @map("shipping_fee")
  discountAmount     Int         @default(0) @map("discount_amount")
  totalAmount        Int         @map("total_amount")
  currency           String      @default("JPY")
  shippingName       String      @map("shipping_name")
  shippingPhone      String      @map("shipping_phone")
  shippingPostalCode String      @map("shipping_postal_code")
  shippingPrefecture String      @map("shipping_prefecture")
  shippingAddress1   String      @map("shipping_address_1")
  shippingAddress2   String?     @map("shipping_address_2")
  trackingNumber     String?     @map("tracking_number")
  paidAt             DateTime?   @map("paid_at")
  shippedAt          DateTime?   @map("shipped_at")
  deliveredAt        DateTime?   @map("delivered_at")
  canceledAt         DateTime?   @map("canceled_at")
  notes              String?     @db.Text
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  productName String @map("product_name")
  variantName String @map("variant_name")
  unitPrice   Int    @map("unit_price")
  quantity    Int
  subtotal    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// =====================================================================
// Tickets
// =====================================================================

model TicketEvent {
  id              String    @id @default(uuid()) @db.Uuid
  externalEventId String    @unique @map("external_event_id")
  title           String
  description     String?   @db.Text
  venue           String?
  performedAt     DateTime  @map("performed_at")
  presaleStartAt  DateTime? @map("presale_start_at")
  presaleEndAt    DateTime? @map("presale_end_at")
  publicSaleAt    DateTime? @map("public_sale_at")
  requiredPlan    PlanType  @default(STANDARD) @map("required_plan")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  presaleGrants TicketPresaleGrant[]

  @@index([performedAt])
  @@map("ticket_events")
}

model TicketLink {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @unique @map("user_id") @db.Uuid
  lawsonUserId String           @unique @map("lawson_user_id")
  status       TicketLinkStatus @default(PENDING)
  linkedAt     DateTime?        @map("linked_at")
  revokedAt    DateTime?        @map("revoked_at")
  verifyToken  String?          @map("verify_token")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants TicketPresaleGrant[]

  @@map("ticket_links")
}

model TicketPresaleGrant {
  id           String    @id @default(uuid()) @db.Uuid
  ticketLinkId String    @map("ticket_link_id") @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  grantedAt    DateTime  @default(now()) @map("granted_at")
  expiresAt    DateTime? @map("expires_at")
  redeemedAt   DateTime? @map("redeemed_at")

  ticketLink TicketLink  @relation(fields: [ticketLinkId], references: [id], onDelete: Cascade)
  event      TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([ticketLinkId, eventId])
  @@map("ticket_presale_grants")
}

// =====================================================================
// Payments
// =====================================================================

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  kind                  PaymentKind
  status                PaymentStatus
  amount                Int
  currency              String        @default("JPY")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  stripeInvoiceId       String?       @unique @map("stripe_invoice_id")
  stripeChargeId        String?       @map("stripe_charge_id")
  receiptUrl            String?       @map("receipt_url")
  failureReason         String?       @map("failure_reason")
  subscriptionId        String?       @map("subscription_id") @db.Uuid
  orderId               String?       @map("order_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([type])
  @@map("stripe_webhook_events")
}

// =====================================================================
// Audit Logs
// =====================================================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  resource  String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// =====================================================================
// Admin Invitation (管理者メール招待)
//  - スーパー管理者がメールアドレス宛に管理者権限を招待する
//  - 新規（アカウント未作成）・既存ユーザー両対応
//  - 受諾時に対象ロール(ADMIN / SUPER_ADMIN)へ昇格 / 新規アカウント作成
// =====================================================================
model AdminInvitation {
  id           String                @id @default(uuid()) @db.Uuid
  email        String                @db.Citext
  role         UserRole              @default(ADMIN) // 付与予定ロール (ADMIN | SUPER_ADMIN)
  // 受諾時に付与する管理権限 (ADMIN のときのみ意味を持つ)
  capabilities String[]              @default([])
  token        String                @unique // 受諾URL用トークン (URLセーフ)
  status       AdminInvitationStatus @default(PENDING)
  // 招待発行者 (SUPER_ADMIN)
  invitedById  String?               @map("invited_by_id") @db.Uuid
  // 受諾したユーザー
  acceptedById String?               @map("accepted_by_id") @db.Uuid
  acceptedAt   DateTime?             @map("accepted_at")
  revokedAt    DateTime?             @map("revoked_at")
  expiresAt    DateTime              @map("expires_at")
  // 招待時のメモ (任意)
  note         String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  invitedBy  User? @relation("AdminInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("AdminInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, expiresAt])
  @@map("admin_invitations")
}

// =====================================================================
// Game (恋愛 ADV) — キャラ・シナリオ・アイテム
// =====================================================================

/// 恋愛対象キャラクターのマスタ
model GameCharacter {
  id            String              @id @default(uuid()) @db.Uuid
  slug          String              @unique
  name          String
  furigana      String?
  catchcopy     String? // 一行紹介
  description   String?             @db.Text
  age           Int?
  birthday      String? // "MM-DD"
  bloodType     String?             @map("blood_type")
  height        Int? // cm
  // ビジュアル
  portraitUrl   String?             @map("portrait_url") // サムネ
  spriteUrl     String?             @map("sprite_url") // デフォルト立ち絵
  themeColor    String?             @map("theme_color") // #ed1c75 等
  // システム
  status        GameCharacterStatus @default(DRAFT)
  sortOrder     Int                 @default(0) @map("sort_order")
  isPremiumOnly Boolean             @default(false) @map("is_premium_only")
  // 親密度の上限 (0-100 推奨)
  affinityMax   Int                 @default(100) @map("affinity_max")
  publishedAt   DateTime?           @map("published_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  scenarios  GameScenario[]
  items      GameItem[]
  assets     GameAsset[]
  progresses PlayerProgress[]
  saveSlots  PlayerSaveSlot[]

  @@index([status, sortOrder])
  @@map("game_characters")
}

/// シナリオ章 (1 章 = 複数シーン)
model GameScenario {
  id                String             @id @default(uuid()) @db.Uuid
  characterId       String             @map("character_id") @db.Uuid
  slug              String
  chapterNumber     Int                @map("chapter_number")
  title             String
  summary           String?            @db.Text
  // シナリオ DSL JSON 本体 (scenes / lines / choices / effects)
  scriptJson        Json               @map("script_json")
  // 課金 (Stripe / JPY)
  priceJpy          Int                @default(0) @map("price_jpy") // 0 = 無料
  isFreeTrial       Boolean            @default(false) @map("is_free_trial") // プロローグ等
  isPremiumIncluded Boolean            @default(false) @map("is_premium_included") // PREMIUM 会員は購入不要
  // Pui での購入 (null/0 = Pui 購入不可、Stripe 課金のみ)
  puiPrice          Int?               @map("pui_price")
  // アクセス
  status            GameScenarioStatus @default(DRAFT)
  requiredAffinity  Int                @default(0) @map("required_affinity") // 解放に必要な親密度
  estimatedMinutes  Int?               @map("estimated_minutes")
  publishedAt       DateTime?          @map("published_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  character   GameCharacter     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  inventories PlayerInventory[]
  purchases   PlayerPurchase[]

  @@unique([characterId, chapterNumber])
  @@unique([characterId, slug])
  @@index([status])
  @@map("game_scenarios")
}

/// アイテム (プレゼント / 衣装 / CG 集 等の確定型 DLC)
model GameItem {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique
  characterId   String?      @map("character_id") @db.Uuid // null = 全キャラ共通
  kind          GameItemKind
  name          String
  description   String?      @db.Text
  iconUrl       String?      @map("icon_url")
  // 課金 (Stripe / JPY)
  priceJpy      Int          @default(0) @map("price_jpy")
  isPremiumOnly Boolean      @default(false) @map("is_premium_only")
  // Pui での購入 (null/0 = Pui 購入不可、Stripe 課金のみ)
  puiPrice      Int?         @map("pui_price")
  // ゲーム効果 (プレゼント時の親密度上昇)
  affinityBoost Int          @default(0) @map("affinity_boost")
  // 同時所持の上限 (null = 無制限、1 = 一回購入のみ)
  maxOwn        Int?         @map("max_own")
  isActive      Boolean      @default(true) @map("is_active")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  character   GameCharacter?    @relation(fields: [characterId], references: [id], onDelete: SetNull)
  inventories PlayerInventory[]
  purchases   PlayerPurchase[]
  bonusGrants BonusGiftGrant[]

  @@index([kind, isActive])
  @@index([characterId])
  @@map("game_items")
}

/// アセット (立ち絵差分・CG・BGM・SE・ボイス) 管理
model GameAsset {
  id          String        @id @default(uuid()) @db.Uuid
  characterId String?       @map("character_id") @db.Uuid // null = 共通アセット
  kind        GameAssetKind
  key         String // 参照キー (例: "happy", "bg_classroom", "bgm_main")
  url         String // S3 / CloudFront URL
  alt         String? // 説明
  metadata    Json? // duration, dimensions 等
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  character GameCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([characterId, kind, key])
  @@index([kind])
  @@map("game_assets")
}

// =====================================================================
// Game (恋愛 ADV) — プレイヤー進行状況
// =====================================================================

/// ユーザーごとのキャラクター単位の進行状況
model PlayerProgress {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  characterId      String          @map("character_id") @db.Uuid
  // パラメータ
  affinity         Int             @default(0) // 親密度 0-100
  routeResult      GameRouteResult @default(IN_PROGRESS) @map("route_result")
  // 統計
  totalPlayMinutes Int             @default(0) @map("total_play_minutes")
  // フラグ (シナリオで参照する true/false 状態)
  flagsJson        Json            @default("{}") @map("flags_json")
  // 最後にプレイした章
  lastScenarioId   String?         @map("last_scenario_id") @db.Uuid
  lastSceneKey     String?         @map("last_scene_key")
  startedAt        DateTime        @default(now()) @map("started_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  character GameCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
  @@map("player_progresses")
}

/// 購入済み章 / 所持アイテム
model PlayerInventory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  // どちらか一方が入る
  scenarioId  String?  @map("scenario_id") @db.Uuid
  itemId      String?  @map("item_id") @db.Uuid
  quantity    Int      @default(1) // アイテムの場合は所持数
  isCompleted Boolean  @default(false) @map("is_completed") // 章クリア済みフラグ
  acquiredAt  DateTime @default(now()) @map("acquired_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario GameScenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  item     GameItem?     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@unique([userId, itemId])
  @@index([userId])
  @@map("player_inventories")
}

/// 課金履歴 (Stripe 連携)
model PlayerPurchase {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @map("user_id") @db.Uuid
  kind                    GamePurchaseKind
  // どちらか一方
  scenarioId              String?               @map("scenario_id") @db.Uuid
  itemId                  String?               @map("item_id") @db.Uuid
  quantity                Int                   @default(1)
  // 決済手段 (Stripe 課金 or Pui 消費)
  payMethod               GamePurchasePayMethod @default(STRIPE) @map("pay_method")
  // 価格 (Stripe 決済のときのみ意味を持つ。Pui 決済時は 0)
  amountJpy               Int                   @map("amount_jpy")
  // Pui 決済のときの消費 Pui 数 (Stripe 決済時は null)
  puiAmount               Int?                  @map("pui_amount")
  // Stripe
  stripePaymentIntentId   String?               @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?               @unique @map("stripe_checkout_session_id")
  paymentStatus           PaymentStatus         @default(PENDING) @map("payment_status")
  paidAt                  DateTime?             @map("paid_at")
  refundedAt              DateTime?             @map("refunded_at")
  metadata                Json?
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario GameScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  item     GameItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([paymentStatus])
  @@map("player_purchases")
}

/// セーブスロット (プラン別上限: FREE=1 / STANDARD=3 / PREMIUM=10)
model PlayerSaveSlot {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  characterId  String   @map("character_id") @db.Uuid
  slotIndex    Int      @map("slot_index") // 0-9 (プランによって有効範囲が変わる)
  // セーブデータ (現在のシナリオ・シーン・親密度・フラグ)
  snapshotJson Json     @map("snapshot_json")
  label        String? // ユーザーが付けるラベル
  thumbnailUrl String?  @map("thumbnail_url")
  savedAt      DateTime @default(now()) @map("saved_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  character GameCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId, slotIndex])
  @@index([userId])
  @@map("player_save_slots")
}

// =====================================================================
// Game (恋愛 ADV) — 月次ボーナスギフト (会員特典)
// =====================================================================

/// 月次ボーナスギフト付与履歴
///
/// STANDARD 会員: 1 個/月、PREMIUM 会員: 5 個/月 を自動付与。
/// (yearMonth, userId) でユニークにすることで二重付与を防止。
/// 実際の付与処理は POST /api/subscriptions/monthly-bonus (Cron / 管理画面から起動)
model BonusGiftGrant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  yearMonth String   @map("year_month") // "YYYY-MM" 形式
  plan      PlanType // 付与時点のプラン
  count     Int // 付与数 (STANDARD=1, PREMIUM=5)
  itemId    String   @map("item_id") @db.Uuid // 付与した GameItem (DEFAULT_BONUS_ITEM_SLUG)
  grantedAt DateTime @default(now()) @map("granted_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item GameItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, yearMonth])
  @@index([yearMonth])
  @@map("bonus_gift_grants")
}

// =====================================================================
// Call Event (特典会 1on1) — CD シリアル引換 + 待機室 + 本ルーム
// =====================================================================

/// 1on1 特典会イベント
///
/// performer (アイドル) が固定された 1 イベントに対し、CD 封入シリアルコードを
/// 通じてファンが引換 (CallTicket 作成) し、当日待機室から順に本ルームへ呼ばれる。
/// 1 ファン = 1 イベント = 1 チケット (Ticket の @@unique で保証)。
model CallEvent {
  id            String          @id @default(uuid()) @db.Uuid
  title         String // "○○リリイベ 1on1"
  description   String?         @db.Text // 概要・タイムテーブル等
  noticeText    String?         @map("notice_text") @db.Text // 待機室で表示する注意事項
  performerId   String          @map("performer_id") @db.Uuid // アイドルの userId
  startsAt      DateTime        @map("starts_at") // 開催開始日時
  endsAt        DateTime?       @map("ends_at") // 終了予定 (任意)
  perFanSeconds Int             @default(60) @map("per_fan_seconds") // 1人あたりの持ち時間 (秒)
  status        CallEventStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  performer User         @relation("CallEventPerformer", fields: [performerId], references: [id], onDelete: Restrict)
  serials   CallSerial[]
  tickets   CallTicket[]

  @@index([performerId])
  @@index([status])
  @@index([startsAt])
  @@map("call_events")
}

/// CD 封入シリアルコード
///
/// イベント開催に先立って管理者が CSV で N 枚発行する。
/// code は大文字・数字のみで構成 (例: "ABCD-1234-EFGH")。
/// 1 シリアル = 1 回のみ引換可能 (usedById が一度入ったら以降ロック)。
model CallSerial {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  code      String    @unique // CD 封入される文字列
  usedById  String?   @map("used_by_id") @db.Uuid // null = 未使用
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  event  CallEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  usedBy User?     @relation("CallSerialUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([usedById])
  @@map("call_serials")
}

/// 引換済みチケット
///
/// シリアル 1 つ = チケット 1 つ。queuePos は引換順 (1, 2, 3, ...) で
/// 待機キューの並び順として使われる。1 イベントに 1 ユーザー 1 チケット限定。
model CallTicket {
  id               String           @id @default(uuid()) @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  serialId         String           @unique @map("serial_id") @db.Uuid
  queuePos         Int              @map("queue_pos") // 引換順 = 待機順
  status           CallTicketStatus @default(WAITING)
  enteredWaitingAt DateTime?        @map("entered_waiting_at")
  enteredMainAt    DateTime?        @map("entered_main_at")
  endedAt          DateTime?        @map("ended_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  event CallEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId]) // 1イベントに1ユーザー1チケット
  @@index([eventId, queuePos])
  @@index([eventId, status])
  @@map("call_tickets")
}

// =====================================================================
// Membership Card & Points (会員カード & ポイント)
// =====================================================================

/// 会員番号採番カウンター (RR-000123 形式)。
/// 単一行 (id=1) を $transaction 内で更新し、連番を払い出す。
/// PM2 cluster でも DB の行ロックで一意性が保証される。
model MemberCounter {
  id   Int @id @default(1)
  next Int @default(1) // 次に払い出す番号

  @@map("member_counter")
}

/// Pui 取引履歴 (増減の単一の真実)。
/// User.pui は本テーブルの合計と一致するよう、付与/消費は必ず
/// $transaction で「履歴作成 + 残高更新」を同時に行う。
/// 【2026-07 通貨名変更】旧 PointTransaction / point_transactions から改名。
model PuiTransaction {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  amount    Int // 正=付与, 負=消費
  balance   Int // 取引後の残高 (監査用スナップショット)
  reason    PuiReason
  note      String? // 任意メモ (管理者調整の理由など)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("pui_transactions")
}

// =====================================================================
// ポイントパック購入 (Stripe) — Pui を課金で購入する
//
// 【2026-07 統合】以前はここで付与される先が「特典ポイント (rewardPoints)」という
// Fan ポイントとは別枠の通貨だったが、Pui 1 種類に統合した。
// モデル名・テーブル名 (RewardPointPack 等) は変更していないが、実際に増減するのは
// User.pui / PuiTransaction (Pui) である。
// =====================================================================

/// Pui の販売パック (管理画面で作成。Stripe Checkout の line item に使う)。
/// 例: 「500Pui ¥500」「3,000Pui ¥2,800 (お得)」など。
model RewardPointPack {
  id        String   @id @default(uuid()) @db.Uuid
  name      String // 表示名 (例: "Pui 500 パック")
  pui       Int // 付与される Pui 数
  priceJpy  Int      @map("price_jpy") // 販売価格 (税込想定)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases RewardPointPurchase[]

  @@index([isActive, sortOrder])
  @@map("reward_point_packs")
}

/// Pui パックの Stripe 購入履歴。
/// checkout.session.completed / payment_intent.succeeded で SUCCEEDED に遷移し、
/// 同一トランザクションで PuiTransaction を作成 + User.pui を加算する。
model RewardPointPurchase {
  id                      String                    @id @default(uuid()) @db.Uuid
  userId                  String                    @map("user_id") @db.Uuid
  packId                  String                    @map("pack_id") @db.Uuid
  pui                     Int // 購入時点のパックの Pui 数 (スナップショット)
  amountJpy               Int                       @map("amount_jpy") // 購入時点の価格 (スナップショット)
  status                  RewardPointPurchaseStatus @default(PENDING)
  stripePaymentIntentId   String?                   @unique @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?                   @unique @map("stripe_checkout_session_id")
  paidAt                  DateTime?                 @map("paid_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack RewardPointPack @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
  @@map("reward_point_purchases")
}

/// 景品カタログ (Pui で交換できる景品)。
/// グッズ (発送必要) / 特典会優先枠 / デジタル特典 の 3 種別。
/// 【2026-07 統合】以前は特典ポイント (旧 rewardPoints) を消費していたが、
/// Pui 1 種類への統合により、現在は Pui (User.pui) を消費する。
model RewardCatalogItem {
  id          String                  @id @default(uuid()) @db.Uuid
  slug        String                  @unique
  kind        RewardCatalogItemKind
  name        String
  description String?                 @db.Text
  imageUrl    String?                 @map("image_url")
  // 交換に必要な Pui 数
  puiCost     Int                     @map("pui_cost")
  // 在庫管理 (null = 無制限。GOODS/CALL_PRIORITY は在庫を切らすことが多いので数値を推奨)
  stock       Int?
  status      RewardCatalogItemStatus @default(DRAFT)
  sortOrder   Int                     @default(0) @map("sort_order")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  redemptions   RewardRedemption[]
  digitalAssets RewardDigitalAsset[]
  downloadLogs  RewardDownloadLog[]

  @@index([status, sortOrder])
  @@index([kind])
  @@map("reward_catalog_items")
}

/// デジタル特典のダウンロード履歴 (景品単位)。
/// /api/me/reward-downloads/[assetId] でファイル配信に成功した際に 1 件記録する。
/// 集計は景品 (catalogItemId) 単位で「延べ回数」と「ユニーク人数 (distinct userId)」を出す。
model RewardDownloadLog {
  id            String   @id @default(uuid()) @db.Uuid
  catalogItemId String   @map("catalog_item_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  catalogItem RewardCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([catalogItemId, createdAt])
  @@index([catalogItemId, userId])
  @@map("reward_download_logs")
}

/// デジタル特典 (DIGITAL) の配布ファイル。
/// 1 つの景品 (RewardCatalogItem) に複数の壁紙などを紐づけられる。
/// 交換済み (DIGITAL の RewardRedemption を持つ) 会員のみが
/// /api/me/reward-downloads/[assetId] 経由でダウンロードできる。
/// 保存方式は ProductImage と同じ二段構え:
///  - S3 アセットバケット設定時: url が S3/CloudFront を指し、data は null。
///  - S3 未設定時: data (Bytes) に本体を保持し /api/me/reward-downloads 経由で配信。
model RewardDigitalAsset {
  id            String   @id @default(uuid()) @db.Uuid
  catalogItemId String   @map("catalog_item_id") @db.Uuid
  fileName      String   @map("file_name") // 表示 / ダウンロード時のファイル名
  contentType   String   @map("content_type")
  fileSize      Int      @map("file_size") // バイト数
  url           String? // S3/CloudFront の URL (S3 設定時)
  data          Bytes? // DB 保存フォールバック (S3 未設定時)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  catalogItem RewardCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId, sortOrder])
  @@map("reward_digital_assets")
}

/// 景品交換履歴 (発送管理を含む)。
/// 交換確定時に RewardCatalogItem.stock を原子的にデクリメントし、
/// 同一トランザクションで PuiTransaction (Pui 消費) を作成する。
/// GOODS は発送フロー (PENDING→PROCESSING→SHIPPED→COMPLETED) を辿り、
/// CALL_PRIORITY / DIGITAL は運営確認後 COMPLETED に遷移する想定。
model RewardRedemption {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @map("user_id") @db.Uuid
  catalogItemId      String                 @map("catalog_item_id") @db.Uuid
  // 交換時点のスナップショット (カタログ変更後も履歴の意味が変わらないように)
  itemName           String                 @map("item_name")
  itemKind           RewardCatalogItemKind  @map("item_kind")
  puiCost            Int                    @map("pui_cost")
  status             RewardRedemptionStatus @default(PENDING)
  // 発送先スナップショット (GOODS のみ意味を持つ。申請時点の User 住所をコピー)
  shippingName       String?                @map("shipping_name")
  shippingPhone      String?                @map("shipping_phone")
  shippingPostalCode String?                @map("shipping_postal_code")
  shippingPrefecture String?                @map("shipping_prefecture")
  shippingAddress1   String?                @map("shipping_address_1")
  shippingAddress2   String?                @map("shipping_address_2")
  trackingNumber     String?                @map("tracking_number")
  adminNote          String?                @map("admin_note") @db.Text
  shippedAt          DateTime?              @map("shipped_at")
  completedAt        DateTime?              @map("completed_at")
  canceledAt         DateTime?              @map("canceled_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem RewardCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("reward_redemptions")
}

/// 毎日のログインボーナス受領記録。
/// userId + date (JST の YYYY-MM-DD) のユニーク制約で 1 日 1 回に限定。
model LoginBonusGrant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      String // JST 基準の "YYYY-MM-DD"
  streak    Int      @default(1) // 連続ログイン日数 (この付与時点)
  amount    Int // 付与ポイント (基本 + 連続ボーナス)
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("login_bonus_grants")
}

/// SNS シェアによるポイント付与記録。
/// userId + date + platform のユニーク制約で「1 プラットフォーム 1 日 1 回」に限定。
model SocialShareGrant {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  date      String // JST 基準の "YYYY-MM-DD"
  platform  SocialPlatform
  amount    Int // 付与ポイント
  grantedAt DateTime       @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, platform])
  @@index([userId, date])
  @@map("social_share_grants")
}

/// SNS シェア「意図」の記録。
/// 実際にシェアボタン (X の共有インテント / Web 共有 API 等) を開いたときに 1 行作成する。
/// Pui の受取 (SocialShareGrant 作成) は、この意図が存在し、かつ一定の
/// 経過時間 (dwell) を満たした場合のみ許可する。これにより「シェアせずに
/// 受取ボタンだけ押して Pui を得る」不正を防ぐ (サーバー側で強制)。
/// userId + date + platform のユニーク制約で 1 日 1 意図に集約する。
model SocialShareIntent {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  date      String // JST 基準の "YYYY-MM-DD"
  platform  SocialPlatform
  openedAt  DateTime       @default(now()) @map("opened_at") // 直近でシェアを開いた時刻
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, platform])
  @@index([userId, date])
  @@map("social_share_intents")
}

/// ミニゲームの 1 プレイ記録。
/// サーバー側で勝敗を確定し、その都度 1 行を作成する (改ざん不可能な権威ある記録)。
/// 「1 日 N 回まで」の制限は userId + gameType + date(JST) の件数を数えて判定する。
/// 勝利時の Pui 付与は PuiTransaction と同一トランザクションで作成する。
model MiniGamePlay {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  gameType  MiniGameType   @map("game_type")
  date      String // JST 基準の "YYYY-MM-DD" (1 日の回数制限の集計キー)
  result    MiniGameResult
  // 付与 Pui (勝利時のみ > 0)。
  // 【2026-07 統合】以前は Fan ポイント (rewardPoint) と特典ポイント (bonusRewardPoint、
  // 薄い還元率・1日上限あり) の 2 枠に分けて付与していたが、Pui 1 種類への
  // 統合に伴い bonusRewardPoint は廃止し、この 1 フィールドのみで勝利報酬を表す
  // (経済性維持のため、廃止分は ACCHI_WIN_REWARD の増額で相殺している)。
  rewardPui Int            @default(0) @map("reward_pui")
  // 監査・検証用の手の記録 (JSON 文字列)。例: {"jankenPlayer":"ROCK","jankenCpu":"SCISSORS",...}
  detail    String?
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameType, date])
  @@index([userId, createdAt])
  @@map("mini_game_plays")
}

/// 月次サブスク Pui 自動付与の記録。
/// userId + yearMonth のユニーク制約で同月の二重付与を防止する。
/// 実際の付与処理は POST /api/subscriptions/monthly-bonus (Cron / 管理画面から起動) の
/// Pui 付与部分で使う (BonusGiftGrant とは別テーブル: ギフト現物 と Pui は別管理)。
model MonthlyRewardPointGrant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  yearMonth String   @map("year_month") // "YYYY-MM" 形式
  plan      PlanType // 付与時点のプラン
  pui       Int // 付与した Pui 数
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth])
  @@index([yearMonth])
  @@map("monthly_reward_point_grants")
}

/// ミニゲームの「本日の追加プレイ回数」を Pui で購入した記録。
/// userId + gameType + date (JST) ごとに 1 行を upsert し、purchasedCount を加算する。
/// 1 日の上限 (ACCHI_MAX_PLAYS_PER_DAY) に、この購入分を上乗せして判定する。
model MiniGameExtraPlayPurchase {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  gameType       MiniGameType @map("game_type")
  date           String // JST 基準の "YYYY-MM-DD"
  purchasedCount Int          @default(0) @map("purchased_count") // 累計購入回数 (この日)
  totalPuiSpent  Int          @default(0) @map("total_pui_spent") // この日に使った Pui 累計
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType, date])
  @@map("mini_game_extra_play_purchases")
}

/// ファンから REIRIE への DM。
/// - 一方向 (ファン → REIRIE)。運営は管理画面で閲覧・既読化できる。
/// - body は送信時点の本文 (@ メンションは送信時に preferredName へ展開済み)。
/// - NG ワードチェックは送信 API でサーバー側でも実施 (改ざん防止)。
model DirectMessage {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  // 送信時点のファンの「呼んでほしい名前」のスナップショット (表示・監査用)
  senderName String?             @map("sender_name")
  body       String
  status     DirectMessageStatus @default(SENT)
  readAt     DateTime?           @map("read_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("direct_messages")
}

/// 運営 (SUPER_ADMIN) からファンへの警告通知。
/// BAN の前段階、あるいは注意喚起として送るもので、メール通知のみ (サイト内表示は行わない)。
/// 複数回発行可能で、履歴として全件保持する (削除しない)。
model UserWarning {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  reason     String // 管理者が入力する警告理由・本文 (メール本文にも使用)
  issuedById String   @map("issued_by_id") @db.Uuid
  emailSent  Boolean  @default(false) @map("email_sent")
  emailError String?  @map("email_error")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User @relation("UserWarningTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User @relation("UserWarningIssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_warnings")
}

/// 永続アプリ設定 (key-value)。
/// Pui 付与レートなど、管理者が変更し本番でも永続させたい数値を保持。
/// value は JSON 文字列で保存し、アプリ側でパースする。
model AppSetting {
  key       String   @id
  value     String // JSON 文字列
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// ゲーム用の音声 (あっち向いてホイのキャラボイス等)。
/// 管理画面からアップロードし、slot ごとに 1 件だけ保持する (再アップロードで置き換え)。
/// 保存方針は ProductImage と同じ:
///   - S3 アセットバケットが設定済み → S3 に置き url は外部URL / data は null。
///   - 未設定 → data にバイト列を保存し /api/media/game-audio/{id} 経由で配信。
/// standalone + PM2 cluster + 再ビルドでも消えない単一の真実として DB を用いる。
model GameAudio {
  id          String   @id @default(uuid()) @db.Uuid
  /// 用途を表すスロット識別子 (例: acchi.voiceStart)。同一 slot は 1 件のみ。
  slot        String   @unique
  url         String
  contentType String?  @map("content_type")
  /// 元ファイル名 (表示用)
  fileName    String?  @map("file_name")
  sizeBytes   Int?     @map("size_bytes")
  data        Bytes?   @map("data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("game_audios")
}

/// サイト内の差し替え可能画像 (トップページのヒーロー画像等)。
/// 管理画面からアップロードし、slot ごとに 1 件だけ保持する (再アップロードで置き換え)。
/// 保存方針は GameAudio / ProductImage と同じ:
///   - S3 アセットバケットが設定済み → S3 に置き url は外部URL / data は null。
///   - 未設定 → data にバイト列を保存し /api/media/site-image/{id} 経由で配信。
/// standalone + PM2 cluster + 再ビルドでも消えない単一の真実として DB を用いる。
model SiteImage {
  id          String   @id @default(uuid()) @db.Uuid
  /// 用途を表すスロット識別子 (例: home.hero)。同一 slot は 1 件のみ。
  slot        String   @unique
  url         String
  contentType String?  @map("content_type")
  /// 元ファイル名 (表示用)
  fileName    String?  @map("file_name")
  sizeBytes   Int?     @map("size_bytes")
  data        Bytes?   @map("data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_images")
}

/// あっち向いてホイのキャラクター画像 (ポーズごとの差し替え可能画像)。
/// 管理画面からアップロードし、slot (ポーズ ID: idle/rock/scissors/paper/up/down/left/right)
/// ごとに 1 件だけ保持する (再アップロードで置き換え)。
/// 保存方針は GameAudio / SiteImage と同じ:
///   - S3 アセットバケットが設定済み → S3 に置き url は外部URL / data は null。
///   - 未設定 → data にバイト列を保存し /api/media/character-image/{id} 経由で配信。
/// standalone + PM2 cluster + 再ビルドでも消えない単一の真実として DB を用いる。
model CharacterImage {
  id          String   @id @default(uuid()) @db.Uuid
  /// ポーズ ID (例: idle, rock, scissors, paper, up, down, left, right)。
  slot        String
  /// 同一ポーズ内のパターン番号 (1〜3)。ゲーム表示時はこの中からランダムに 1 枚選ばれる。
  variant     Int      @default(1)
  url         String
  contentType String?  @map("content_type")
  /// 元ファイル名 (表示用)
  fileName    String?  @map("file_name")
  sizeBytes   Int?     @map("size_bytes")
  data        Bytes?   @map("data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// ポーズ + パターン番号で一意 (再アップロードは同じ (slot, variant) を置き換え)。
  @@unique([slot, variant])
  @@map("character_images")
}

// =====================================================================
// Announcements (お知らせ配信 — サイト内表示 + 一斉メール送信)
// =====================================================================

enum AnnouncementAudience {
  ALL // 全ユーザー (未登録含む、公開ページに表示)
  MEMBERS // 会員のみ (ログインユーザー全体)
  PREMIUM // PREMIUM プラン会員のみ
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

/// メール一斉送信の進行状況。
/// PUBLISHED かつ sendEmail=true の場合のみメール送信が発生する。
enum AnnouncementEmailStatus {
  NOT_REQUESTED // メール配信を希望しない (サイト内表示のみ)
  PENDING // 配信対象を確定し送信待ち (キュー投入直後)
  SENDING // 送信処理中 (バッチをまたいで送信中)
  COMPLETED // 全対象への送信 (成功/失敗判定含む) が完了
  FAILED // 送信処理自体が異常終了した (リトライ要)
}

model Announcement {
  id       String               @id @default(uuid()) @db.Uuid
  title    String
  body     String
  audience AnnouncementAudience @default(ALL)
  status   AnnouncementStatus   @default(DRAFT)

  // --- メール一斉送信 ---
  /// 公開時にメールも送信するか (サイト内表示のみにしたい場合は false)
  sendEmail           Boolean                 @default(false) @map("send_email")
  emailStatus         AnnouncementEmailStatus @default(NOT_REQUESTED) @map("email_status")
  /// 送信対象として確定した人数 (キュー投入時にスナップショット)
  emailRecipientCount Int?                    @map("email_recipient_count")
  /// 送信に成功した人数 (完了後に確定)
  emailSentCount      Int?                    @map("email_sent_count")
  /// 送信に失敗した人数
  emailFailedCount    Int?                    @map("email_failed_count")
  emailStartedAt      DateTime?               @map("email_started_at")
  emailCompletedAt    DateTime?               @map("email_completed_at")
  /// 直近のエラー内容 (FAILED 時の調査用)
  emailError          String?                 @map("email_error")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([emailStatus])
  @@map("announcements")
}

// =====================================================================
// Contact (お問い合わせ)
// =====================================================================

/// サイトのお問い合わせフォームから送信されたメッセージ。
/// - ログイン中のユーザーは userId が紐づく。ゲスト送信は userId = null。
/// - 管理画面 (/super-admin/contact) で一覧・対応状況の更新を行う。
model ContactMessage {
  id        String          @id @default(uuid()) @db.Uuid
  // 送信者情報 (フォーム入力値。ログイン中でもフォーム値を保存する)
  name      String
  email     String
  category  ContactCategory @default(GENERAL)
  subject   String
  message   String          @db.Text
  // 対応状況 (管理側で更新)
  status    ContactStatus   @default(NEW)
  // 管理者用メモ (対応内容の記録など。ユーザーには見えない)
  adminNote String?         @map("admin_note") @db.Text
  // 濫用対策・調査用のメタ情報
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  // ログイン中に送信した場合の紐づけ (ゲストは null)
  userId    String?         @map("user_id") @db.Uuid
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}

// =====================================================================
// Birthday Mail (誕生日メール)
// =====================================================================
//
// 会員の誕生日に、画像付きの「お祝いメール」を運営が送信できる機能。
//   - BirthdayMailTemplate : 年ごと (2026 版など) のメール内容 (件名・本文・画像) の設定。
//   - BirthdayMailDelivery : 「誰に・いつ送ったか」の配信記録。マイページでの閲覧にも使う。
//
// 送信対象は「その日が誕生日 (birthDate の月日が一致) で、かつその年 (year) に
// まだ配信していない」会員。管理画面から今日の対象者一覧・未送信者一覧を確認し、
// 個別 / 一斉送信できる。送信すると Delivery 行が作られ、二重送信を防ぐ。

/// 年ごとの誕生日メールテンプレート (2026 版など)。年 (year) に対して 1 件。
model BirthdayMailTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  /// 対象年 (西暦)。この年に誕生日を迎える会員へ送るメールの内容。年ごとに 1 件。
  year             Int      @unique
  /// メール件名。差し込み変数 {name} が使える (会員の呼び名に置換)。
  subject          String
  /// メール本文 (プレーンテキスト / 軽いマークダウン)。差し込み変数 {name} が使える。
  body             String   @db.Text
  /// 添付・埋め込み画像の配信 URL (S3 の外部URL または /api/media/birthday-mail/{id})。
  imageUrl         String?  @map("image_url")
  /// 画像を DB 保存 (S3 未設定時) する場合のバイト列と付随情報。
  imageContentType String?  @map("image_content_type")
  imageFileName    String?  @map("image_file_name")
  imageSizeBytes   Int?     @map("image_size_bytes")
  imageData        Bytes?   @map("image_data")
  /// 有効フラグ。false の年は送信操作をブロックする (誤送信防止)。
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  deliveries BirthdayMailDelivery[]

  @@map("birthday_mail_templates")
}

/// 誕生日メールの配信記録 (会員 × 年ごとに最大 1 件)。
/// マイページではこの記録を参照して、届いた誕生日メールを表示する。
model BirthdayMailDelivery {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 対象年 (西暦)。同一会員・同一年で二重送信しないための一意キーの一部。
  year       Int
  /// 送信時点のテンプレート (削除された場合は null に落とすが記録は残す)。
  templateId String?               @map("template_id") @db.Uuid
  template   BirthdayMailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// 送信時点の内容スナップショット (テンプレ変更後も届いた内容を保持)。
  subject    String
  body       String                @db.Text
  imageUrl   String?               @map("image_url")
  /// 実際にメール送信できたか (SES 成功時 true)。false は記録のみ (再送対象)。
  emailSent  Boolean               @default(false) @map("email_sent")
  /// 送信日時。
  sentAt     DateTime              @default(now()) @map("sent_at")
  /// 会員がマイページで初めて閲覧した日時 (未読判定用)。
  readAt     DateTime?             @map("read_at")

  @@unique([userId, year])
  @@index([year, sentAt])
  @@map("birthday_mail_deliveries")
}
