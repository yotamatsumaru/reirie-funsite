{
  "name": "@idol/video-job-complete",
  "version": "0.1.0",
  "private": true,
  "description": "MediaConvert Job State Change (EventBridge) → Web API /api/admin/videos/job-complete への通知ブリッジ Lambda",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@aws-sdk/* --external:aws-sdk --minify --sourcemap",
    "build:zip": "pnpm run build && node scripts/make-zip.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint'",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2"
  }
}
