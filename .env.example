# ==========================================
# Application
# ==========================================
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ==========================================
# Demo mode (DB なしで UI のみ動かす)
#   - サンドボックス / プレビュー用
#   - 本番では 0 (もしくは未設定)
# ==========================================
DEMO_MODE=0
NEXT_PUBLIC_DEMO_MODE=0

# ==========================================
# Maintenance mode (緊急時に強制 ON)
#   - 1 / true で全リクエストを /maintenance にリダイレクト
#   - 通常はスーパー管理者画面から動的に ON/OFF できる
# ==========================================
# MAINTENANCE_MODE=1

# ==========================================
# Auth.js v5 (NextAuth)
# ==========================================
# 生成: openssl rand -base64 32
AUTH_SECRET=replace-with-32-byte-base64-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# TOTP (Google Authenticator) 2段階認証のシークレット暗号化鍵。SUPER_ADMIN 限定機能で使用。
# 未設定時は AUTH_SECRET を代わりに使う (別鍵で管理したい場合のみ設定すればOK)。
# 生成: openssl rand -base64 32
# TOTP_ENCRYPTION_KEY=replace-with-32-byte-base64-secret

# ==========================================
# Database (PostgreSQL 15)
# ==========================================
DATABASE_URL=postgresql://idol:idolpass@localhost:5432/idol_fansite?schema=public

# ==========================================
# AWS
# ==========================================
AWS_REGION=ap-northeast-1

# S3 / CloudFront
S3_ASSET_BUCKET=idol-fansite-assets-dev
S3_VIDEO_BUCKET=idol-fansite-videos-dev
CLOUDFRONT_ASSET_DOMAIN=dxxxxxx.cloudfront.net
CLOUDFRONT_VIDEO_DOMAIN=dyyyyyy.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=APKAXXXXXXXXXXXX
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...REPLACE_ME...\n-----END RSA PRIVATE KEY-----"

# IVS (Live)
IVS_CHANNEL_ARN=arn:aws:ivs:ap-northeast-1:000000000000:channel/REPLACE_ME
IVS_PLAYBACK_KEY_PAIR_ID=REPLACE_ME
IVS_PLAYBACK_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...REPLACE_ME...\n-----END EC PRIVATE KEY-----"

# SES
SES_FROM_EMAIL=no-reply@example.com

# ==========================================
# Stripe
# ==========================================
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STANDARD_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PREMIUM_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_STANDARD_YEARLY=price_REPLACE_ME
STRIPE_PRICE_PREMIUM_YEARLY=price_REPLACE_ME

# ==========================================
# Lawson Ticket API
# ==========================================
LAWSON_TICKET_API_BASE=https://partners.l-tike.com/api
LAWSON_TICKET_API_KEY=REPLACE_ME
LAWSON_TICKET_PARTNER_ID=REPLACE_ME

# ==========================================
# Public (Next.js client)
# ==========================================
NEXT_PUBLIC_CLOUDFRONT_ASSET_DOMAIN=dxxxxxx.cloudfront.net

# ==========================================
# WebRTC TURN servers (特典会 1on1 / 通話用)
#   - 設定がなければ STUN のみで動作 (LAN またぎ等で失敗する可能性あり)
#   - Cloudflare TURN や Twilio TURN を想定。CSV で複数 URL を指定可能。
#   - URLS は ; (セミコロン) 区切りで複数可
# ==========================================
# TURN_URLS=turn:turn.example.com:3478?transport=udp;turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=replace-me
# TURN_CREDENTIAL=replace-me
